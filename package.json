{
  "name": "zkh-canvas-renderer",
  "version": "0.3.2",
  "description": "uni-app 跨端 Canvas 渲染引擎，解析 Fabric.js JSON 并在各平台绘制",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "publish": "npm publish --registry https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "uni-app",
    "canvas",
    "fabric",
    "fabric.js",
    "renderer",
    "wechat",
    "miniprogram",
    "cross-platform"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/uni-app": "^1.4.8",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
